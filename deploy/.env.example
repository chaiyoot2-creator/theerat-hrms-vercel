# Copy to deploy/.env on the VPS and fill in. Never commit the real .env.

# Domain that points (DNS A record) to this VPS. Must match vercel.json rewrite destination.
API_DOMAIN=hrapi.theeratfeed.com
# Email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.com

# Database password: generate with  openssl rand -hex 24
POSTGRES_PASSWORD=

# Session signing secret: generate with  openssl rand -hex 32
JWT_SECRET=

# Public URL of the Vercel frontend (used in password-reset emails)
APP_URL=https://hr.theeratfeed.com

# First boot creates an OWNER employee with this email; then register that email at /register
OWNER_EMAIL=
OWNER_NAME=เจ้าของกิจการ

# Optional: password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Google Sheets mirror (share the sheet with the service-account email as Editor)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the "private_key" value from the service-account JSON as one line, keeping the \n sequences
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
